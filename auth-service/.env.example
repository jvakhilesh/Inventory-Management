# Copy this file to .env in the auth-service folder and replace every placeholder.
DB_URL=jdbc:mysql://localhost:3306/auth_service
DB_USERNAME=root
DB_PASSWORD=replace_with_your_mysql_password
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
ADMIN_EMAIL=your_admin_email@example.com

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me
FACEBOOK_CLIENT_ID=replace_me
FACEBOOK_CLIENT_SECRET=replace_me

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
