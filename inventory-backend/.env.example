# Copy this file to .env in the inventory-backend folder and replace placeholders.
DB_URL=jdbc:mysql://localhost:3306/inventory_management
DB_USER=root
DB_PASS=replace_with_your_mysql_password
# MUST be the exact same value as JWT_SECRET_KEY in Auth Service.
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
SERVER_PORT=8081

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
STOCK_ALERT_ENABLED=true
STOCK_ALERT_RECIPIENT=admin@example.com
STOCK_ALERT_FIXED_RATE_MS=300000
STOCK_ALERT_INITIAL_DELAY_MS=30000
